---
import { proofTeaser } from '@/data/proof';
---

<p class="proof-teaser">
  {proofTeaser.role}
  {
    proofTeaser.slots.map((slot, index) => (
      <>
        {index === 0 ? ' — ' : '; '}
        <span
          class:list={['metric', slot.redactable && 'metric--redactable']}
          title={slot.redactable ? 'Placeholder metric — may redact' : undefined}
        >
          {slot.label}
        </span>
      </>
    ))
  }.
</p>
