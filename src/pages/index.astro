---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { proof, site } from '@/site';

const pieces = (await getCollection('pieces')).filter((entry) => !entry.data.draft);

const talks = pieces
  .filter((entry) => entry.data.kind === 'talk')
  .sort((a, b) => {
    if (a.data.proofTheme === 'syntax-fm') return -1;
    if (b.data.proofTheme === 'syntax-fm') return 1;
    return b.data.date.valueOf() - a.data.date.valueOf();
  });

const writing = pieces
  .filter((entry) => entry.data.kind === 'writing')
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout>
  <header class="hero">
    <p class="identity">{site.name}</p>
    <h1>{site.headline}</h1>
    <p class="subhead">{site.subhead}</p>
    <p class="hero-link">
      <a href={`mailto:${site.email}`}>Email</a>
      <span aria-hidden="true"> · </span>
      <a href="/writing">Writing</a>
    </p>
  </header>

  <section class="section" aria-labelledby="help-heading">
    <h2 id="help-heading">Ways I can help</h2>
    <p>{site.help}</p>
  </section>

  <section class="section" aria-labelledby="proof-heading">
    <h2 id="proof-heading">Proof</h2>
    {
      proof.map((item) => (
        <div class="proof">
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </div>
      ))
    }
  </section>

  <section class="section" aria-labelledby="talks-heading">
    <h2 id="talks-heading">Talks</h2>
    <ul class="list">
      {
        talks.map((entry) => (
          <li>
            <a href={`/writing/${entry.id}`}>
              <span class="list-title">{entry.data.title}</span>
              <span class="list-meta">{entry.data.venue}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section" aria-labelledby="writing-heading">
    <h2 id="writing-heading">Writing</h2>
    <ul class="list">
      {
        writing.map((entry) => (
          <li>
            <a href={`/writing/${entry.id}`}>
              <span class="list-title">{entry.data.title}</span>
              <span class="list-meta">
                {entry.data.placeholder ? 'Draft slot' : entry.data.description}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="more"><a href="/writing">All writing and talks</a></p>
  </section>

  <section class="section" aria-labelledby="now-heading">
    <h2 id="now-heading">Now</h2>
    <p>
      A current snapshot lives on <a href="/now">/now</a>.
    </p>
  </section>
</BaseLayout>
