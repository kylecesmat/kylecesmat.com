---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { proofTeaser } from '@/data/proof';
import { site } from '@/site';
---

<BaseLayout
  title="About"
  description="Press kit for Kyle Cesmat — Agent Experience, platform, developer experience, and AI engineering leadership."
>
  <header class="hero">
    <h1 class="page-title">About</h1>
    <p class="subhead">Press kit. Placeholders only beyond resume-backed facts below.</p>
  </header>

  <div class="prose">
    <h2>Headshot</h2>
    <p>
      <span class="placeholder">[TODO: press kit — headshot]</span>
    </p>

    <h2>Bio</h2>
    <p>
      <span class="placeholder">[TODO: press kit — short bio]</span>
    </p>

    <h2>Facts</h2>
    <ul>
      <li>{proofTeaser.role}</li>
      {
        proofTeaser.slots.map((slot) => (
          <li>
            <span
              class:list={['metric', slot.redactable && 'metric--redactable']}
              title={slot.redactable ? 'Placeholder metric — may redact' : undefined}
            >
              {slot.label}
            </span>
          </li>
        ))
      }
    </ul>

    <h2>Contact</h2>
    <p>
      <a href="/contact">Contact</a>
      <span aria-hidden="true"> · </span>
      <a href={`mailto:${site.email}`}>{site.email}</a>
      <span aria-hidden="true"> · </span>
      <a href={site.linkedin} rel="me noopener noreferrer" target="_blank">
        LinkedIn
      </a>
    </p>
  </div>
</BaseLayout>
