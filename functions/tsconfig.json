{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["esnext"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["./types.d.ts"]
  },
  "include": ["./**/*.ts", "./types.d.ts", "../src/lib/listening.ts", "../src/lib/spotify-track.ts"]
}
