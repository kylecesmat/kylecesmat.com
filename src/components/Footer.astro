---
import { CONTACT_EMAIL, SOURCE_URL } from '../data/site';
---

<!-- The previous site's sign-off, then the two things a curious visitor or an
     agent might want: the source and the Markdown. -->
<footer
  class="mx-auto mt-auto w-full max-w-3xl px-8 pt-20 pb-10 text-center text-sm text-muted-foreground"
>
  <p>
    Thanks for visiting.{' '}
    <a href={`mailto:${CONTACT_EMAIL}`} class="link-mark py-1 text-foreground">Send me an email</a>
    {' '}if you’d like to say hello.
  </p>
  <p class="mt-4">
    <a
      href={SOURCE_URL}
      target="_blank"
      rel="noopener noreferrer"
      class="link-mark py-1 text-foreground"
    >
      Source on GitHub<span class="sr-only"> (opens in new tab)</span>
    </a>
    <span aria-hidden="true"> · </span>
    For agents:{' '}
    <a href="/llms.txt" class="link-mark py-1 font-mono text-foreground">/llms.txt</a>
  </p>
</footer>
