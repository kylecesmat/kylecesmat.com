---
import { site, nav, hero, headlinePick } from '@/site';
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
}

const { title, description = site.description, canonical } = Astro.props;
const homeTitle =
  headlinePick === 'placeholder' ? site.name : `${site.name} — ${hero.headline}`;
const pageTitle = title ? `${title} · ${site.name}` : homeTitle;
const canonicalUrl = new URL(canonical ?? Astro.url.pathname, site.url).href;
const ogTitle = title ? `${title} · ${site.name}` : pageTitle;
const analyticsToken = import.meta.env.PUBLIC_CF_WEB_ANALYTICS_TOKEN;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: site.url,
  email: site.email,
  jobTitle: site.jobTitle,
  worksFor: {
    '@type': 'Organization',
    name: site.worksFor,
  },
  description: site.description,
  homeLocation: {
    '@type': 'Place',
    name: site.location,
  },
  sameAs: site.social.map((item) => item.href),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta name="theme-color" content="#faf9f6" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:creator" content="@kylecesmat" />

    <meta name="robots" content="index,follow" />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />

    {
      analyticsToken ? (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: analyticsToken })}
        />
      ) : null
    }
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="site-header__inner">
        <a class="wordmark" href="/" aria-current={path === '/' ? 'page' : undefined}>
          {site.name}
        </a>
        <nav aria-label="Primary">
          <ul class="nav">
            {
              nav.map((item) => {
                const current =
                  path === item.href || path.startsWith(`${item.href}/`);
                return (
                  <li>
                    <a href={item.href} aria-current={current ? 'page' : undefined}>
                      {item.label}
                    </a>
                  </li>
                );
              })
            }
          </ul>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="site-footer__inner">
        <p>
          <a href={`mailto:${site.email}`}>Email Kyle</a>
          <span aria-hidden="true"> · </span>
          <a href="/now">Now</a>
          <span aria-hidden="true"> · </span>
          <a href="/archive">Archive</a>
        </p>
        <ul class="social">
          {
            site.social.map((item) => (
              <li>
                <a href={item.href} rel="me noopener noreferrer" target="_blank">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </footer>
  </body>
</html>
