---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { site } from '@/site';
---

<BaseLayout
  title="About"
  description="About and contact for Kyle Cesmat — Agent Experience, platform, and developer experience."
>
  <header class="hero">
    <h1 class="page-title">About</h1>
    <p class="subhead">
      <span class="placeholder">{site.aboutTeaser}</span>
    </p>
  </header>

  <div class="prose">
    <h2>Contact</h2>
    <p>
      <a href={`mailto:${site.email}`}>{site.email}</a>
    </p>
    <p>
      <a href={site.linkedin} rel="me noopener noreferrer" target="_blank">
        LinkedIn
      </a>
    </p>
    <ul class="plain">
      {
        site.social.map((item) => (
          <li>
            <a href={item.href} rel="me noopener noreferrer" target="_blank">
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
    <p>
      Earlier Formidable work and meetup talks are in the <a href="/archive">archive</a>.
    </p>
  </div>
</BaseLayout>
