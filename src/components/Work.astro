---
import { companies } from '../data/work';
import { periodLabel } from '../lib/dates';
import { inlineMarkdown } from '../lib/inline-markdown';
import DateRange from './DateRange.astro';

if (companies.length === 0) throw new Error('No companies in src/data/work.ts');

const slug = (name: string) => name.toLowerCase().replace(/[^a-z0-9]+/g, '-');

const logoBase = 'h-8 w-8 shrink-0 rounded-full';
---

<!--
  The work history: one timeline at every width, each company a collapsible
  row, the most recent open by default and any number open at once.

  Every row is its own grid with the same columns, so the dots line up from
  row to row: `[spine | content]` when the section is narrow and
  `[date | spine | content]` once it is wide enough (a container query on the
  list, not the viewport). The panel is a subgrid across all of them, so a
  role's dates sit in the same margin as its company's and its dot on the
  same line. Rows: 1 = header (dot, name, chevron), 2 = date (narrow only),
  3 = what the company is, which shows whether or not the row is open,
  4 = the panel.

  A role gets a sentence or two: what it came to.

  Closed panels stay in the DOM and are hidden with `data-closed` rather than
  the `hidden` attribute, which Tailwind's preflight makes impossible to
  override: this way the whole history prints, and shows without JavaScript.
-->
<section aria-labelledby="work-heading" class="flex w-full flex-col gap-2">
  <h2 id="work-heading" class="heading-section">Work Experience</h2>
  <ol data-slot="accordion" class="@container flex w-full flex-col">
    {
      companies.map((company, index) => {
        const open = index === 0;
        const id = `work-${slug(company.name)}`;
        return (
          <li
            data-slot="accordion-item"
            class="group grid grid-cols-[auto_1fr] gap-x-4 @2xl:grid-cols-[10rem_auto_1fr]"
          >
            {periodLabel(company) && (
              <p class="col-start-2 row-start-2 pb-1 text-sm font-semibold text-muted-foreground @2xl:col-start-1 @2xl:row-start-1 @2xl:self-center @2xl:pb-0 @2xl:text-right @2xl:whitespace-nowrap">
                <DateRange start={company.start} end={company.end} />
              </p>
            )}
            {/* The dot and the line down to the next row. A closed row is only
                as tall as its header, so the spine keeps a minimum height that
                leaves a stretch of line between one dot and the next. The
                last row has nothing below it to reach, so its line shows only
                while its panel is open and there are roles to thread. */}
            <div
              aria-hidden="true"
              class="timeline-spine col-start-1 row-start-1 row-end-5 flex min-h-16 w-4 flex-col items-center group-last:min-h-0 @2xl:col-start-2"
            >
              <span class="timeline-dot-box flex h-12 shrink-0 items-center">
                <span class="timeline-dot size-2 rounded-full bg-mark ring-4 ring-background forced-colors:bg-[CanvasText]" />
              </span>
              <span class="timeline-line w-px flex-1 bg-border group-last:group-has-data-closed:hidden forced-colors:bg-[CanvasText]" />
            </div>
            <h3 class="col-start-2 row-start-1 flex @2xl:col-start-3">
              <button
                type="button"
                id={`${id}-trigger`}
                aria-controls={`${id}-panel`}
                aria-expanded={open ? 'true' : 'false'}
                data-slot="accordion-trigger"
                class="group/accordion-trigger flex min-h-12 flex-1 items-center justify-between gap-3 py-2 text-left text-lg font-semibold text-foreground outline-hidden transition-colors focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background"
              >
                <span class="flex items-center gap-3">
                  {company.logo && (
                    <img
                      src={company.logo}
                      width="32"
                      height="32"
                      alt=""
                      loading="lazy"
                      class:list={[logoBase, company.logoDark && 'dark:hidden print:block!']}
                    />
                  )}
                  {company.logo && company.logoDark && (
                    <img
                      src={company.logoDark}
                      width="32"
                      height="32"
                      alt=""
                      loading="lazy"
                      class:list={[logoBase, 'hidden dark:block print:hidden!']}
                    />
                  )}
                  {/* The chevron is hidden from assistive tech, so the name says what the button does.
                      Kept on one line so no space lands before the comma. */}
                  {/* prettier-ignore */}
                  <span>{company.name}<span class="sr-only" data-accordion-verb set:text={open ? ', hide roles' : ', show roles'} /></span>
                </span>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  class="accordion-chevron size-4 shrink-0 text-muted-foreground print:hidden"
                >
                  <path d="m6 9 6 6 6-6" />
                </svg>
              </button>
            </h3>
            {company.summary && (
              <p
                class="col-start-2 row-start-3 max-w-prose pb-2 text-sm text-muted-foreground @2xl:col-start-3"
                set:html={inlineMarkdown(company.summary)}
              />
            )}
            <div
              id={`${id}-panel`}
              role="region"
              aria-labelledby={`${id}-trigger`}
              data-slot="accordion-content"
              data-closed={open ? undefined : ''}
              class="col-span-full row-start-4 grid grid-cols-subgrid overflow-hidden text-sm data-closed:hidden print:grid! print:h-auto!"
            >
              <div class="col-span-full grid grid-cols-subgrid pt-2 pb-8 group-last:pb-0">
                {company.entries.length > 0 && (
                  <ul class="col-span-full grid grid-cols-subgrid gap-y-6">
                    {company.entries.map((entry) => (
                      <li
                        data-slot="role"
                        class="col-span-full grid grid-cols-subgrid items-baseline print:break-inside-avoid"
                      >
                        {/* A smaller dot on the same spine: one per role. */}
                        <span
                          aria-hidden="true"
                          class="col-start-1 row-start-1 flex h-6 w-4 items-center justify-center self-start @2xl:col-start-2"
                        >
                          <span class="size-1.5 rounded-full bg-muted-foreground ring-4 ring-background forced-colors:bg-[CanvasText]" />
                        </span>
                        <h4 class="col-start-2 row-start-1 text-base leading-6 font-medium @2xl:col-start-3">
                          {entry.title}
                        </h4>
                        {(entry.subtitle || periodLabel(entry)) && (
                          <div class="col-start-2 row-start-2 flex flex-wrap items-baseline justify-between gap-x-4 @2xl:contents">
                            {entry.subtitle && (
                              <p class="font-semibold text-primary @2xl:col-start-3 @2xl:row-start-2">
                                {entry.subtitle}
                              </p>
                            )}
                            {periodLabel(entry) && (
                              <p class="text-xs text-muted-foreground @2xl:col-start-1 @2xl:row-start-1 @2xl:text-right @2xl:whitespace-nowrap">
                                <DateRange start={entry.start} end={entry.end} />
                              </p>
                            )}
                          </div>
                        )}
                        {entry.impact && (
                          <p
                            class="col-start-2 row-start-3 mt-1.5 max-w-prose leading-relaxed text-pretty @2xl:col-start-3"
                            set:html={inlineMarkdown(entry.impact)}
                          />
                        )}
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </div>
          </li>
        );
      })
    }
  </ol>
  <noscript>
    <style is:inline>
      [data-slot='accordion-content'] {
        display: grid !important;
      }
    </style>
  </noscript>
</section>

<script>
  const EASE_OUT = 'cubic-bezier(0, 0, 0.2, 1)';
  const DURATION = 200;

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const running = new WeakMap<HTMLElement, Animation>();

  function toggle(trigger: HTMLButtonElement) {
    const panel = document.getElementById(trigger.getAttribute('aria-controls') ?? '');
    if (!panel) return;

    const open = trigger.getAttribute('aria-expanded') !== 'true';
    trigger.setAttribute('aria-expanded', String(open));
    const verb = trigger.querySelector('[data-accordion-verb]');
    if (verb) verb.textContent = open ? ', hide roles' : ', show roles';

    // A second click mid-animation picks up from the height on screen.
    const from = panel.getBoundingClientRect().height;
    running.get(panel)?.cancel();

    if (open) panel.removeAttribute('data-closed');
    if (reduceMotion.matches) {
      panel.toggleAttribute('data-closed', !open);
      return;
    }

    const to = open ? panel.scrollHeight : 0;
    // The closing animation holds its last frame until the panel is hidden,
    // so the full height never flashes back for a frame.
    const animation = panel.animate(
      { height: [`${from}px`, `${to}px`] },
      { duration: DURATION, easing: EASE_OUT, fill: open ? 'none' : 'forwards' },
    );
    running.set(panel, animation);
    animation.onfinish = () => {
      if (!open) {
        panel.setAttribute('data-closed', '');
        animation.cancel();
      }
    };

    if (open) {
      panel.firstElementChild?.animate(
        { opacity: [0, 1], translate: ['0 -0.25rem', '0 0'] },
        { duration: DURATION, easing: EASE_OUT },
      );
    }
  }

  for (const trigger of document.querySelectorAll<HTMLButtonElement>(
    '[data-slot="accordion-trigger"]',
  )) {
    trigger.addEventListener('click', () => toggle(trigger));
  }
</script>
