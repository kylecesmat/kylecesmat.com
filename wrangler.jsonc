{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kylecesmat",
  "compatibility_date": "2026-09-01",
  // Production is the Pages project `kylecesmat`. GitHub Actions deploys
  // `dist/` and attaches kylecesmat.com. Nameservers stay on Cloudflare.
  "pages_build_output_dir": "./dist",
  // Spotify names are Pages secrets and .dev.vars. `wrangler pages deploy`
  // rejects a `secrets` key, so the types live in functions/env.d.ts.
}
