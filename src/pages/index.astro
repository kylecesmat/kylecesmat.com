---
import About from '../components/About.astro';
import AgentView from '../components/AgentView.astro';
import Education from '../components/Education.astro';
import PersonJsonLd from '../components/PersonJsonLd.astro';
import Talks from '../components/Talks.astro';
import Work from '../components/Work.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout home>
  <PersonJsonLd slot="head" />
  <div class="flex flex-col items-center justify-center gap-16 pt-8 md:gap-20 md:pt-12">
    <!-- The human view; hidden by CSS while the agent view is showing. -->
    <div class="human-view flex w-full flex-col items-center gap-16 md:gap-20">
      <About />
      <Work />
      <Talks />
      <Education />
    </div>
    <AgentView />
  </div>
</BaseLayout>
