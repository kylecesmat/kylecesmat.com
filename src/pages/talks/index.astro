---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { talks } from '@/data/talks';
---

<BaseLayout
  title="Talks & media"
  description="Talks and podcasts from Kyle Cesmat on Agent Experience and AI coding at scale."
>
  <header class="hero">
    <h1 class="page-title">Talks & media</h1>
  </header>

  <section class="section">
    <ul class="list">
      {
        talks.map((talk) => (
          <li>
            <a href={talk.notesHref ?? talk.href ?? '#'}>
              <span class="list-title">{talk.title}</span>
              <span class="list-meta">
                {talk.venue}
                {talk.linkLabel ? ` · ${talk.linkLabel}` : ''}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
