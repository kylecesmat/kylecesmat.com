---
import { Image } from 'astro:assets';

import profile from '../assets/profile.jpg';
import { LINKS, SITE_NAME } from '../data/site';
import { navHref } from '../lib/public-href';
import ContactLine from './ContactLine.astro';
import ThemeButton from './ThemeButton.astro';
import ViewToggle from './ViewToggle.astro';

interface Props {
  /** The home page: the name is the page's heading and the view switch shows. */
  home?: boolean;
  /** A small control back home, in place of the portrait and name. */
  backHome?: boolean;
}

const { home = false, backHome = false } = Astro.props;

const focusRing =
  'outline-hidden focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background';

// Built pages are files (current.html); the address people use has no extension.
const path = Astro.url.pathname.replace(/(\/index)?\.html$/, '').replace(/\/$/, '') || '/';
---

<!--
  Two parts. A bar with the small links on the left and the switches on the
  right; and below it, in normal flow, the identity block: the portrait and
  the name. The currently page has neither, and a small arrow home sits at
  the left of the bar instead. The bar spans the window so its background
  meets both edges; its contents keep the page's column. From the `sm`
  breakpoint the bar is one row and sticks to the top as the page scrolls.
  Narrower than that the links and the switches do not fit side by side, so
  they take a row each and the bar scrolls away with the page rather than
  hold two rows of a small screen.
-->
<header class="site-bar top-0 z-40 w-full sm:sticky print:hidden">
  <div
    class="mx-auto flex w-full max-w-3xl flex-wrap items-center justify-between gap-x-2 px-5 py-1 sm:px-8 sm:py-2"
  >
    <div class="flex min-w-0 items-center">
      {
        backHome && (
          <a
            href="/"
            aria-label="Home"
            class:list={[
              'inline-flex size-9 shrink-0 items-center justify-center rounded-full text-foreground ring-offset-background transition-colors hover:bg-accent',
              focusRing,
            ]}
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              class="size-4 rtl:-scale-x-100"
            >
              <path d="M19 12H5" />
              <path d="m12 19-7-7 7-7" />
            </svg>
          </a>
        )
      }
      <nav aria-label="Elsewhere">
        <ul
          class:list={[
            'dim-others flex flex-wrap text-[0.8125rem] min-[23.5rem]:text-sm',
            backHome
              ? '-mr-1.5 ml-1 min-[23.5rem]:-mr-2 sm:-mr-2.5'
              : '-mx-1.5 min-[23.5rem]:-mx-2 sm:-mx-2.5',
          ]}
        >
          {
            LINKS.map((link) => {
              const external = /^https?:/.test(link.url);
              const here = !external && (link.url.replace(/\/$/, '') || '/') === path;
              return (
                <li>
                  <a
                    href={navHref(link.url)}
                    class:list={[
                      'inline-block rounded-sm px-1.5 py-3 min-[23.5rem]:px-2 sm:px-2.5',
                      focusRing,
                    ]}
                    {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                    aria-current={here ? 'page' : undefined}
                  >
                    <span class="link-quiet">{link.label}</span>
                    {external && <span class="sr-only"> (opens in new tab)</span>}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </nav>
    </div>
    <div class="ml-auto flex items-center gap-2">
      {home && <ViewToggle />}
      <ThemeButton />
    </div>
  </div>
</header>
{
  home ? (
    <div class="mx-auto flex w-full max-w-3xl items-center gap-4 px-5 pt-4 pb-6 sm:px-8 md:gap-5 md:pt-6 md:pb-8 print:max-w-none print:px-0 print:pt-0">
      {/* 160px covers 2× on both breakpoints; 320px is for 3× phones. */}
      <Image
        src={profile}
        alt=""
        width={80}
        height={80}
        widths={[160, 320]}
        sizes="(min-width: 768px) 80px, 64px"
        format="webp"
        priority
        class="h-16 w-16 shrink-0 rounded-full object-cover md:h-20 md:w-20"
      />
      <div class="flex flex-col gap-2">
        <h1 class="text-3xl font-semibold md:text-[2.5rem]/none">{SITE_NAME}</h1>
        {/* The bar and the footer stay off paper, so the addresses go here. */}
        <div class="hidden print:block">
          <ContactLine />
        </div>
      </div>
    </div>
  ) : (
    !backHome && (
      /* Every other page: the same portrait and name, smaller, as the way home.
       The currently page uses the arrow in the bar instead. The page supplies
       its own heading. */
      <div class="mx-auto w-full max-w-3xl px-5 pt-4 sm:px-8 md:pt-6 print:hidden">
        <a
          href="/"
          aria-label={`${SITE_NAME}, home`}
          class:list={['inline-flex items-center gap-3 rounded-full py-1 pr-3', focusRing]}
        >
          <Image
            src={profile}
            alt=""
            width={40}
            height={40}
            widths={[80, 120]}
            sizes="40px"
            format="webp"
            priority
            class="h-10 w-10 shrink-0 rounded-full object-cover"
          />
          <span class="font-semibold tracking-tight">
            <span class="link-mark">{SITE_NAME}</span>
          </span>
        </a>
      </div>
    )
  )
}
