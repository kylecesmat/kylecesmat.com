---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { talks as talkList } from '@/data/talks';

export async function getStaticPaths() {
  const notes = await getCollection('talks');
  return notes.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const listed = talkList.find((talk) => talk.id === entry.id);
const title = listed?.title ?? entry.data.title;
const venue = listed?.venue ?? entry.data.venue;
---

<BaseLayout title={title} description={entry.data.description}>
  <article class="prose">
    <p class="identity">talk</p>
    <h1>{title}</h1>
    <p class="meta">{venue}{entry.data.placeholder ? ' · notes slot' : ''}</p>
    <Content />
  </article>
</BaseLayout>
