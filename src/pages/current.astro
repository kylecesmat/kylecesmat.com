---
import { CURRENT_UPDATED, current } from '../data/current';
import { inlineMarkdown } from '../lib/inline-markdown';
import BaseLayout from '../layouts/BaseLayout.astro';

const updated = new Intl.DateTimeFormat('en-US', {
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
}).format(new Date(`${CURRENT_UPDATED}-01T00:00:00Z`));
---

<!--
  What I am up to now, from src/data/current.ts: a short table, the label in
  the margin column the home page keeps its dates in and the words beside it.
  The Listening row is not one of those. The browser fills it from
  /api/listening, and it stays hidden when that request has no track.
-->
<BaseLayout
  backHome
  title="Currently"
  description="What Kyle Cesmat is building, doing and into right now."
>
  <article class="flex flex-col gap-8 pt-8 md:gap-10 md:pt-12">
    <header class="flex flex-col gap-3">
      <h1 class="text-3xl font-semibold md:text-[2.5rem]/none">Currently</h1>
      <p class="text-muted-foreground">
        What I’m into right now. Updated <time datetime={CURRENT_UPDATED}>{updated}</time>.
      </p>
    </header>
    <dl class="dim-others @container flex flex-col border-b border-border">
      {
        current.map((row) => (
          <div class="grid gap-x-12 gap-y-1 border-t border-border py-4 @2xl:grid-cols-[10rem_1fr] @2xl:items-baseline">
            <dt class="text-sm text-muted-foreground @2xl:text-right">{row.label}</dt>
            <dd
              class="max-w-prose text-lg leading-relaxed text-pretty"
              set:html={inlineMarkdown(row.text)}
            />
          </div>
        ))
      }
      <div
        id="listening"
        hidden
        class="grid gap-x-12 gap-y-1 border-t border-border py-4 @2xl:grid-cols-[10rem_1fr] @2xl:items-baseline"
      >
        <dt class="text-sm text-muted-foreground @2xl:text-right">Listening</dt>
        <dd class="max-w-prose text-lg leading-relaxed text-pretty">
          Last played <a
            id="listening-link"
            class="link-mark py-2 text-foreground"
            target="_blank"
            rel="noopener noreferrer"
            ><span id="listening-title"></span><span class="sr-only"> (opens in new tab)</span></a
          > by <span id="listening-by"></span>.
        </dd>
      </div>
    </dl>
    <script>
      import { isSpotifyTrackUrl } from '../lib/spotify-track';

      const row = document.getElementById('listening');
      const link = document.getElementById('listening-link');
      const title = document.getElementById('listening-title');
      const by = document.getElementById('listening-by');
      if (
        row instanceof HTMLElement &&
        link instanceof HTMLAnchorElement &&
        title instanceof HTMLElement &&
        by instanceof HTMLElement
      ) {
        fetch('/api/listening', { headers: { accept: 'application/json' } })
          .then((res) => (res.status === 200 ? res.json() : null))
          .then((data: unknown) => {
            if (!data || typeof data !== 'object') return;
            const record = data as { title?: unknown; artist?: unknown; url?: unknown };
            if (
              typeof record.title !== 'string' ||
              typeof record.artist !== 'string' ||
              typeof record.url !== 'string'
            ) {
              return;
            }
            if (!record.title || !record.artist || !isSpotifyTrackUrl(record.url)) return;
            title.textContent = record.title;
            by.textContent = record.artist;
            link.href = record.url;
            row.hidden = false;
          })
          .catch(() => {});
      }
    </script>
  </article>
</BaseLayout>
