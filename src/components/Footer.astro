---
import { CONTACT_EMAIL, LINKS, PLACE, SITE_NAME, SOURCE_URL } from '../data/site';

interface Props {
  /** URL of the contour image the layout already loads for the page top. */
  topo: string;
}

const { topo } = Astro.props;

const degrees = (value: number, positive: string, negative: string) =>
  `${Math.abs(value).toFixed(4)}° ${value >= 0 ? positive : negative}`;
const latitude = degrees(PLACE.latitude, 'N', 'S');
const longitude = degrees(PLACE.longitude, 'E', 'W');

const mapUrl = `https://www.openstreetmap.org/?mlat=${PLACE.latitude}&mlon=${PLACE.longitude}#map=11/${PLACE.latitude}/${PLACE.longitude}`;

const focusRing =
  'outline-hidden focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-muted';
---

<!--
  The sign-off, drawn as a small map of where I am: the contour lines from
  the top of the page, a pin, and a legend with the city's coordinates, its
  elevation and the time there now. Then the previous site's "thanks for
  visiting", the same small links as the top of the page, and the two things
  a curious visitor or an agent might want: the source and the Markdown.
-->
<footer
  class="mx-auto mt-auto w-full max-w-3xl px-5 pt-20 pb-6 sm:px-8 sm:pb-8 md:pt-24 print:hidden"
>
  <div class="place px-6 pt-7 pb-4 sm:px-8 sm:pt-8 sm:pb-5">
    <div aria-hidden="true" class="place-contours" style={`--topo-image:url(${topo})`}></div>
    <div aria-hidden="true" class="place-cross"></div>
    <span aria-hidden="true" class="place-pin"></span>

    <p class="text-lg font-semibold tracking-tight">{SITE_NAME}</p>
    <p class="text-sm text-muted-foreground">{PLACE.name}</p>
    <p class="figures mt-3 flex flex-wrap gap-x-3 font-mono text-xs text-muted-foreground">
      <a
        href={mapUrl}
        target="_blank"
        rel="noopener noreferrer"
        translate="no"
        class:list={['link-quiet rounded-sm py-2 text-foreground', focusRing]}
      >
        {latitude}, {longitude}
        <span class="sr-only"> on a map (opens in new tab)</span>
      </a>
      <span class="py-2">{PLACE.elevation}</span>
      <!-- Filled in by the script below; without it there is nothing to show. -->
      <span class="py-2" hidden data-local-time={PLACE.timeZone}></span>
    </p>

    <p class="mt-12 max-w-[17rem] text-pretty sm:mt-16">
      Thanks for visiting.{' '}
      <a href={`mailto:${CONTACT_EMAIL}`} class="link-mark py-1">Send me an email</a>
      {' '}if you’d like to say hello.
    </p>

    <div class="mt-4 flex flex-wrap items-baseline justify-between gap-x-8 text-sm">
      <nav aria-label="Elsewhere, again">
        <ul class="dim-others -mx-2 flex flex-wrap">
          {
            LINKS.map((link) => {
              const external = /^https?:/.test(link.url);
              return (
                <li>
                  <a
                    href={link.url}
                    class:list={['inline-block rounded-sm px-2 py-3', focusRing]}
                    {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                  >
                    <span class="link-quiet">{link.label}</span>
                    {external && <span class="sr-only"> (opens in new tab)</span>}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </nav>
      <ul class="dim-others -mx-2 flex flex-wrap text-muted-foreground">
        <li>
          <a
            href={SOURCE_URL}
            target="_blank"
            rel="noopener noreferrer"
            class:list={['inline-block rounded-sm px-2 py-3', focusRing]}
          >
            <span class="link-quiet">source</span>
            <span class="sr-only"> on GitHub (opens in new tab)</span>
          </a>
        </li>
        <li>
          <a
            href="/llms.txt"
            class:list={['inline-block rounded-sm px-2 py-3 font-mono text-[0.8125rem]', focusRing]}
          >
            <span class="link-quiet">/llms.txt</span>
          </a>
        </li>
      </ul>
    </div>
    <p
      id="load-timing"
      class="mt-2 flex items-center gap-1.5 font-mono text-xs text-muted-foreground"
      hidden
    >
      <span aria-hidden="true">🚀</span>
      <span id="load-timing-value"></span>
    </p>
  </div>
</footer>

<script>
  const clock = document.querySelector<HTMLElement>('[data-local-time]');
  if (clock) {
    const format = new Intl.DateTimeFormat('en-US', {
      hour: 'numeric',
      minute: '2-digit',
      timeZone: clock.dataset.localTime,
      timeZoneName: 'short',
    });
    const tick = () => {
      clock.textContent = format.format(new Date());
    };
    tick();
    clock.hidden = false;
    window.setInterval(tick, 15_000);
  }

  // From the request being sent through the load event. loadEventEnd is still
  // 0 inside the load handler, so the read waits one task.
  const loadTiming = document.querySelector<HTMLElement>('#load-timing');
  const loadValue = document.querySelector<HTMLElement>('#load-timing-value');
  if (loadTiming && loadValue) {
    const report = () => {
      const nav = performance.getEntriesByType('navigation')[0];
      if (!(nav instanceof PerformanceNavigationTiming) || nav.loadEventEnd <= 0) return;
      loadValue.textContent =
        'Loaded in ' + (nav.loadEventEnd - nav.requestStart).toFixed(5) + ' ms';
      loadTiming.hidden = false;
    };
    if (document.readyState === 'complete') window.setTimeout(report);
    else window.addEventListener('load', () => window.setTimeout(report), { once: true });
  }
</script>
