---
import { Image } from 'astro:assets';

import profile from '../assets/profile.jpg';
import { SITE_MARK, SITE_NAME } from '../data/site';
import ThemeButton from './ThemeButton.astro';
import ViewToggle from './ViewToggle.astro';

interface Props {
  viewToggle?: boolean;
}

const { viewToggle = false } = Astro.props;

const focusRing =
  'outline-hidden focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background';
---

<!--
  Two parts. A bar with the mark on the left and the two switches on the
  right, which sticks to the top of the window as the page scrolls; and below
  it, in normal flow, the identity block: the portrait and the name.
  w-full matters: the body is a flex column, and a flex item with auto side
  margins shrinks to its content instead of stretching.
-->
<header
  class="sticky top-0 z-40 mx-auto w-full max-w-3xl bg-background/85 px-8 backdrop-blur-md print:static print:bg-background"
>
  <div class="flex w-full items-center justify-between py-3">
    <a href="/" aria-label={`${SITE_NAME}, home`} class:list={['rounded-md py-1', focusRing]}>
      <span
        aria-hidden="true"
        translate="no"
        class="font-mono text-2xl leading-none font-semibold text-primary transition-opacity hover:opacity-75 motion-reduce:transition-none"
      >
        {`<${SITE_MARK}>`}
      </span>
    </a>
    <div class="flex items-center gap-2">
      {viewToggle && <ViewToggle />}
      <ThemeButton />
    </div>
  </div>
</header>
<div class="mx-auto flex w-full max-w-3xl items-center gap-4 px-8 pt-3 pb-6 md:gap-5 md:pb-8">
  <a
    href="/"
    aria-label={`${SITE_NAME}, home`}
    class:list={['group shrink-0 rounded-full', focusRing]}
  >
    <!-- On a desktop the portrait rests in grayscale and takes its colour and
         a ring in the accent on hover; phones have no hover and keep the
         colour photo. -->
    <span
      class="block h-16 w-16 overflow-hidden rounded-full ring-primary ring-offset-2 ring-offset-background transition-shadow duration-300 motion-reduce:transition-none md:h-20 md:w-20 md:group-hover:ring-2"
    >
      <!-- 160px covers 2× on both breakpoints; 320px is for 3× phones. -->
      <Image
        src={profile}
        alt={SITE_NAME}
        width={80}
        height={80}
        widths={[160, 320]}
        sizes="(min-width: 768px) 80px, 64px"
        format="webp"
        priority
        class="h-full w-full rounded-full object-cover transition-[filter] duration-300 motion-reduce:transition-none md:grayscale md:group-hover:grayscale-0"
      />
    </span>
  </a>
  <!-- The largest type on the page: the name, one step above the mark. -->
  <h1 class="text-3xl font-bold tracking-tight md:text-[2.5rem]/none">{SITE_NAME}</h1>
</div>
