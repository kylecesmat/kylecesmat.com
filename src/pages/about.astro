---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { site } from '@/site';
---

<BaseLayout
  title="About"
  description="Kyle Cesmat is SEM at Coinbase leading Agent Experience. Platform, developer experience, and applied AI for enterprise engineering orgs."
>
  <header class="hero">
    <p class="eyebrow">About</p>
    <h1 class="page-title">{site.name}</h1>
    <p class="subhead">{site.subhead}</p>
  </header>

  <section class="section prose">
    <h2>Work</h2>
    <p>
      I lead Agent Experience at Coinbase and build the platform, developer
      experience, and AI engineering systems that help large orgs adopt governed
      coding workflows.
    </p>
    <p>
      Formidable-era consulting projects and 2017–2019 meetup talks are on the
      <a href="/archive">archive</a> — not the primary proof for this site.
    </p>

    <h2>Otherwise</h2>
    <p>
      Off work I hike, bike, cook, bake bread, and take road trips. More of the
      current snapshot is on <a href="/now">/now</a>.
    </p>

    <h2>Contact</h2>
    <p>
      <a href={`mailto:${site.email}`}>{site.email}</a>
    </p>
    <ul>
      {
        site.social.map((item) => (
          <li>
            <a href={item.href} rel="me noopener noreferrer" target="_blank">
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
