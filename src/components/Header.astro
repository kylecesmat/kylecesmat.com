---
import { Image } from 'astro:assets';

import profile from '../assets/profile.jpg';
import { SITE_MARK, SITE_NAME } from '../data/site';
import ThemeButton from './ThemeButton.astro';
import ViewToggle from './ViewToggle.astro';

interface Props {
  viewToggle?: boolean;
}

const { viewToggle = false } = Astro.props;

const focusRing =
  'outline-hidden focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background';
---

<!--
  Two parts. A bar with the mark on the left and the two switches on the
  right, which sticks to the top of the window as the page scrolls; and below
  it, in normal flow, the identity block: the portrait and the name. The bar
  spans the window so its background meets both edges; its contents keep the
  page's column.
-->
<header class="site-bar sticky top-0 z-40 w-full print:static print:bg-background">
  <div class="mx-auto flex w-full max-w-3xl items-center justify-between px-8 py-3">
    <a href="/" aria-label={`${SITE_NAME}, home`} class:list={['rounded-md py-1', focusRing]}>
      <span
        aria-hidden="true"
        translate="no"
        class="font-mono text-2xl leading-none font-semibold text-primary transition-opacity hover:opacity-75 motion-reduce:transition-none"
      >
        {`<${SITE_MARK}>`}
      </span>
    </a>
    <div class="flex items-center gap-2">
      {viewToggle && <ViewToggle />}
      <ThemeButton />
    </div>
  </div>
</header>
<div class="mx-auto flex w-full max-w-3xl items-center gap-4 px-8 pt-3 pb-6 md:gap-5 md:pb-8">
  <!-- The portrait is not a link: the mark in the bar is already the way
       home. 160px covers 2× on both breakpoints; 320px is for 3× phones. -->
  <Image
    src={profile}
    alt=""
    width={80}
    height={80}
    widths={[160, 320]}
    sizes="(min-width: 768px) 80px, 64px"
    format="webp"
    priority
    class="h-16 w-16 shrink-0 rounded-full object-cover md:h-20 md:w-20"
  />
  <!-- The largest type on the page: the name, one step above the mark. -->
  <h1 class="text-3xl font-bold tracking-tight md:text-[2.5rem]/none">{SITE_NAME}</h1>
</div>
