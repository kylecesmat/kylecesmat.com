---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Personal website of Kyle Cesmat.' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header>
      <a href="/">Kyle Cesmat</a>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer>
      <p id="load-timing" aria-live="polite"></p>
    </footer>
    <script>
      // Navigation Timing for this document, from the moment the browser sent
      // the request (requestStart) through the load event. DNS, TCP, and TLS
      // are outside that window. Kept inline so measuring the page does not
      // add a request.
      addEventListener(
        'load',
        () => {
          setTimeout(() => {
            const el = document.getElementById('load-timing');
            const nav = performance.getEntriesByType('navigation')[0];
            if (!el || !(nav instanceof PerformanceNavigationTiming) || nav.loadEventEnd <= 0) {
              return;
            }

            const elapsed = nav.loadEventEnd - nav.requestStart;
            el.textContent = 'Loaded in ' + elapsed.toFixed(5) + ' ms';
          });
        },
        { once: true },
      );
    </script>
  </body>
</html>
