---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { site } from '@/site';
---

<BaseLayout title="About" description={site.bio}>
  <header class="hero">
    <h1 class="page-title">{site.name}</h1>
  </header>

  <div class="prose">
    <p>{site.bio}</p>

    <h2>Contact</h2>
    <p>
      <a href={`mailto:${site.email}`}>{site.email}</a>
    </p>
    <ul class="plain">
      {
        site.social.map((item) => (
          <li>
            <a href={item.href} rel="me noopener noreferrer" target="_blank">
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
    <p>
      Earlier Formidable work and meetup talks are in the <a href="/archive">archive</a>.
    </p>
  </div>
</BaseLayout>
