---
import { CONTACT_EMAIL, PROFILES } from '../data/site';

/** The profiles from src/data/site.ts, then email; one row each. */
const items = [
  ...PROFILES.map(({ name, handle, url }) => ({ name, value: handle, url })),
  { name: 'Email', value: CONTACT_EMAIL, url: `mailto:${CONTACT_EMAIL}` },
];
---

<!--
  One row per way to get in touch: the name of the place, in the margin
  column, and the handle as the link. The name is the label, so there is no
  glyph beside it saying the same thing. Links to other sites open in a new
  tab and say so; mailto stays in-tab.
-->
<section aria-labelledby="connect-heading" class="flex w-full flex-col gap-2">
  <h2 id="connect-heading" class="text-2xl font-semibold">Connect</h2>
  <ul data-slot="item-group" class="@container flex w-full flex-col">
    {
      items.map((item) => {
        const external = /^https?:/.test(item.url);
        return (
          <li
            data-slot="item"
            class="grid grid-cols-[4.5rem_1fr] items-baseline gap-x-4 @2xl:grid-cols-[10rem_1fr] @2xl:gap-x-12"
          >
            <span class="text-sm text-muted-foreground @2xl:text-right">{item.name}</span>
            <span>
              <a
                href={item.url}
                translate="no"
                class="link-mark inline-block py-2 font-medium"
                {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
              >
                {item.value}
                {external && <span class="sr-only"> (opens in new tab)</span>}
              </a>
            </span>
          </li>
        );
      })
    }
  </ul>
</section>
